# envswitch: 旧環境 (old) と Nix 環境 (nix) を切り替える。~/nix-config で管理
# どのシェルでも最初に読まれるファイル。モードは `envswitch nix|old` で変更する
_envswitch_file="$HOME/.local/state/envswitch/mode"
_envswitch_mode=old
[[ -r $_envswitch_file ]] && _envswitch_mode=$(<$_envswitch_file)

if [[ $_envswitch_mode == nix ]]; then
  # 旧環境から引き継いだ「読み込み済み」の印を消し、Nix 環境の設定を読み直させる
  unset __ETC_PROFILE_NIX_SOURCED __HM_SESS_VARS_SOURCED __HM_ZSH_SESS_VARS_SOURCED
  source "$HOME/.config-nix/zsh/.zshenv"
else
  # /etc/zshrc が Nix の PATH を足さないようにする（旧環境で Nix 版のツールが優先されるのを防ぐ）
  export __ETC_PROFILE_NIX_SOURCED=1
  # Nix 環境から引き継いだ設定を消す
  unset ZDOTDIR XDG_CONFIG_HOME XDG_BIN_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME \
    STARSHIP_CONFIG GIT_CONFIG_GLOBAL __HM_SESS_VARS_SOURCED __HM_ZSH_SESS_VARS_SOURCED
  path=(${path:#/nix/*})
  path=(${path:#$HOME/.nix-profile/*})
  path=(${path:#/etc/profiles/*})
fi
unset _envswitch_file _envswitch_mode
