#!/bin/sh
# 旧環境 (old) と Nix 環境 (nix) を切り替える。新しく開いたシェルから反映される
f="$HOME/.local/state/envswitch/mode"
case "$1" in
  nix|old)
    mkdir -p "${f%/*}"
    echo "$1" > "$f"
    echo "$1 に切り替えました。新しく開いたタブ・ウィンドウから反映されます"
    ;;
  "") cat "$f" 2>/dev/null || echo old ;;
  *) echo "使い方: envswitch [nix|old]" >&2; exit 1 ;;
esac
