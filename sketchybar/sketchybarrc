#!/usr/bin/env lua
-- sketchybar の設定（Lua。SbarLua を使う）
-- home.nix の launchd.agents.sketchybar が `sketchybar --config このファイル` で起動する
-- このフォルダは ~/nix-config/sketchybar にあり、編集したら `sketchybar --reload` で反映される
--
-- 旧設定（~/.config/sketchybar）をそのまま移し、色だけ palette.nix のものにした（アプリのアイコンなど、ユーザーの希望で変えたところは docs/log.md）

-- このファイルと同じフォルダの Lua（settings.lua や items/ など）を require で読めるようにする
local here = debug.getinfo(1, "S").source:sub(2):match("(.*/)")
package.path = here .. "?.lua;" .. here .. "?/init.lua;" .. package.path

-- 旧設定のコードが使うグローバル変数
SBAR = require("sketchybar")
sbar = SBAR
require("settings")
COLORS = require("colors")
ICONS = require("icons")
GRAPH_UTILS = require("helpers.graph_utils")

SBAR.begin_config()
require("style")
require("items")
SBAR.end_config()

SBAR.event_loop()
