<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cyberdream（bat・delta 用）
  Neovim で scottmckendry/cyberdream.nvim を読みこんだときの実際の色（nvim_get_hl）を取り出し、Neovim の役割（各 name）を bat の方式（TextMate の scope）の名前に当てはめて作ったもの
  Neovim と同じ色の割り当てになるようにしている（読み取り方の違いは残るので、完全には同じにならない）
-->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Cyberdream</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#16181a</string>
				<key>foreground</key>
				<string>#ffffff</string>
				<key>caret</key>
				<string>#ffffff</string>
				<key>lineHighlight</key>
				<string>#3c4048</string>
				<key>selection</key>
				<string>#3c4048</string>
				<key>findHighlight</key>
				<string>#ffffff</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>@punctuation</string>
			<key>scope</key>
			<string>punctuation, meta.brace</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ffffff</string>
				<key>fontStyle</key>
				<string></string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>@punctuation.delimiter</string>
			<key>scope</key>
			<string>punctuation.separator, punctuation.terminator, punctuation.accessor</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ffffff</string>
				<key>fontStyle</key>
				<string></string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>@punctuation.bracket</string>
			<key>scope</key>
			<string>punctuation.section, meta.brace, punctuation.definition.block, punctuation.definition.parameters, punctuation.definition.arguments, punctuation.definition.array, punctuation.definition.dict</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ffffff</string>
				<key>fontStyle</key>
				<string></string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>@variable</string>
			<key>scope</key>
