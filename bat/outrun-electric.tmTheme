<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Outrun Electric（bat・delta 用。自作の配色 nvim/lua/outrun.lua と同じテーマ。Night より背景が暗い）
  VS Code のテーマ「Outrun Electric Meets Synthwave」（edevars/outrun-meets-synthwave）の色分けの決まり（tokenColors）を、
  色の値を参考に TextMate の形で書いたもの。VS Code と bat は同じ決まり（scope）を使うので、そのまま当てはめられる
  カーソル行（lineHighlight）は、元のテーマが背景と同じなので、背景に文字の色を 7% 混ぜた色にした（Neovim と同じ）
-->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Outrun Electric</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
